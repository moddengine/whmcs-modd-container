[Unit]
Description=Modd Hosting Controller
After=docker.service zfs-mount.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/modd-hosting-controller -config /etc/modd-hosting/controller.toml
Restart=on-failure
User=root
Group=root
NoNewPrivileges=true
# Filesystem namespaces must remain disabled: ZFS mounts and Unix socket
# directories created by the controller must be visible to Docker and the host.

[Install]
WantedBy=multi-user.target
